@page
@model pizza_mama.Pages.MenuPizzasModel
@{
}

<html>
    <head>
        <link rel="stylesheet" href="~/css/style.css"/>
        <title>

        </title>
    </head>
    <body>

        <a asp-page="Index">
        <img src ="~/images/small_logo.png" id="small_logo"/>     
        </a>
        <div class = "menu_title">
        <h1>Les Pizzas</h1>
        </div>
        
        <div class="menu_list">
        @foreach (var pizza in Model.Pizza)
        {
            <div class="menu_list_item">
                <span class = "menu_list_title">@pizza.nom</span>
<!-- je mets le arbose car il il s agit du code Cs dans le html, donc le format string.foramt simplement en decimal, ensuite il faut configurer le code le prix si jamais le prix possede , ou . ex 4,3..-->
<!-- donc il faut se rendre dans la configuration dans (configure)  -->
                <span class = "menu_list_price">@String.Format("{0:0.00}", pizza.prix)€</span>
                <span class="menu_list_ingredients">@pizza.ingredients</span>
                @if(pizza.vegetarienne){
                    <span class="menu_list_badge"> Végétarienne</span>
                }                
            </div>
        }
        </div>
    </body>
</html>

